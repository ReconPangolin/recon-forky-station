<!-- TODO: Localisation -->
<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'seed-splicer-menu-title'}"
    MinSize="300 300"
    SetSize="300 300">
    <BoxContainer
        Name="SeedSplicerContainer"
        Margin="0 0 0 0"
        Orientation="Vertical">
        <BoxContainer
            Name="SeedContainer"
            Margin="0 0 0 0"
            Orientation="Horizontal">
            <BoxContainer
                Name="SeedContainerLeft"
                Orientation="Vertical"
                Margin="10 0">
                <Label Name="SeedLabelLeft" Text="no seed loaded"></Label>
                <SpriteView OverrideDirection="South" Scale="2 2" Name="SeedSpriteLeft" Access="Public" SetSize="64 64" />
                <Button Name="EjectButtonLeft" Access="Public" Text="Eject"></Button>
            </BoxContainer>
            <BoxContainer
                Name="SeedContainerRight"
                Orientation="Vertical"
                Margin="10 0">
                <Label Name="SeedLabelRight" Text="no seed loaded"></Label>
                <SpriteView OverrideDirection="South" Scale="2 2" Name="SeedSpriteRight" Access="Public" SetSize="64 64" />
                <Button Name="EjectButtonRight" Access="Public" Text="Eject"></Button>
            </BoxContainer>
        </BoxContainer>
        <Button Name="CombineButton" Access="Public" Text="Splice" Margin="10 10"></Button>
    </BoxContainer>
</controls:FancyWindow>

